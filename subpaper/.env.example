ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
DATABASE_URL=postgres://subpaper:subpaper@localhost:5432/subpaper
# Email-in (Postmark inbound): addresses look like <token>@INBOUND_DOMAIN
INBOUND_DOMAIN=
INBOUND_WEBHOOK_SECRET=
# Reply emails (Postmark outbound). Leave empty to disable replies.
POSTMARK_SERVER_TOKEN=
MAIL_FROM=
# Only reply when the sender passed SPF (stops forged From addresses). Set false to skip the check.
INBOUND_REQUIRE_SPF=true
# Cost controls, per company per UTC day
DAILY_EXTRACTION_CAP=100
DAILY_REPLY_CAP=50
